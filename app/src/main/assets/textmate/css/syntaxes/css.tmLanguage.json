{
  "name": "CSS",
  "scopeName": "source.css",
  "patterns": [
    {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.css"
    },
    {
      "begin": "([^{]+)\\{",
      "beginCaptures": {
        "1": { "name": "entity.name.tag.css" }
      },
      "end": "\\}",
      "patterns": [
        {
          "match": "\\b([a-zA-Z-]+)\\s*:",
          "captures": {
            "1": { "name": "support.type.property-name.css" }
          }
        },
        {
          "match": ":\\s*([^;]+);",
          "captures": {
            "1": { "name": "constant.numeric.css" }
          }
        }
      ]
    }
  ]
}
